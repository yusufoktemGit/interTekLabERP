@model List<interTekLabERP.Entities.SampleRequest>

<div class="d-flex justify-content-between align-items-center mb-3">

    <h3>Numune Kayıtları</h3>

    <div>
        <a asp-action="BulkCreate"
           class="btn btn-primary">
            Toplu Numune Girişi
        </a>

        <a asp-action="Create"
           class="btn btn-success">
            Yeni Numune
        </a>
    </div>

</div>

<form asp-action="ExportExcel" method="get" class="row g-2 align-items-end">
    <div class="col-auto">
        <label class="form-label mb-1">Başlangıç Tarihi</label>
        <input type="date" name="startDate" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label mb-1">Bitiş Tarihi</label>
        <input type="date" name="endDate" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label mb-1">Durum</label>
        <select name="statusId" class="form-select">
            <option value="">Tümü</option>
            <option value="1">Beklemede</option>
            <option value="2">Kargoya Verildi</option>
            <option value="3">Analiz Devam Ediyor</option>
            <option value="4">Rapor Tamamlandı</option>
            <option value="5">İptal Edildi</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-success">
            Excel'e Aktar
        </button>
    </div>
</form>
<small class="text-muted">
    Seçtiğin duruma ve Kabul Tarihi aralığına göre aktarılır.
    Durum "Tümü" ise ve tarih boşsa bütün numuneler gelir.
</small>
<div class="card">

    <div class="card-body">

        <table id="sampleTable" class="table table-striped table-hover">

            <thead class="table-dark">
                <tr>
                    <th>Takip No</th>
                    <th>Teklif No</th>
                    <th>Müşteri</th>
                    <th>Ürün</th>
                    <th>Hizmet Alan</th>
                    <th>Kabul Tarihi</th>
                    <th>Çıkış Tarihi</th>
                    <th>Durum</th>
                    <th width="120">İşlem</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <a asp-action="Detail"
                                   asp-route-id="@item.Id">
                                    @item.TrackingNo
                                </a>
                            </td>

                            <td>@item.OfferNo</td>

                            <td>@item.CustomerName</td>

                            <td>@item.ProductName</td>

                            <td>@item.ServicePurchasedFrom</td>

                            <td>
                                @item.SampleAcceptDate.ToString("dd.MM.yyyy")
                            </td>
                            <td>
                                @(item.ExitDate.HasValue? item.ExitDate.Value.ToString("dd.MM.yyyy") : "-")
                            </td>
                            <td>
                                @if (item.StatusId == 1)
                                {
                                    <span class="badge bg-secondary">
                                        Beklemede
                                    </span>
                                }
                                else if (item.StatusId == 2)
                                {
                                    <span class="badge bg-primary">
                                        Kargoya Verildi
                                    </span>
                                }
                                else if (item.StatusId == 3)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Analiz Devam Ediyor
                                    </span>
                                }
                                else if (item.StatusId == 4)
                                {
                                    <span class="badge bg-success">
                                        Rapor Tamamlandı
                                    </span>
                                }
                                else if (item.StatusId == 5)
                                {
                                    <span class="badge bg-danger">
                                        İptal Edildi
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="Detail"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-primary">
                                    Detay
                                </a>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center">
                            Kayıt bulunamadı.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


@section Scripts
{
    <script>

        $(document).ready(function ()
        {
            $('#sampleTable').DataTable(
            {
                language:
                {
                    url: '//cdn.datatables.net/plug-ins/1.13.8/i18n/tr.json'
                },
                pageLength: 25,
                order: [[0, "desc"]],
                stateSave: true,
                stateDuration: -1

            });
        });
         

    </script>
}