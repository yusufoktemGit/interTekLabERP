@model interTekLabERP.Entities.SampleRequest
@using interTekLabERP.Entities
@using InterTekLabERP.Entities.Domain

@{
    ViewData["Title"] = "Numune Detayı";

    string? delayText = null;
    string delayClass = "bg-success";

    if (Model.TargetDate.HasValue && Model.StatusId != 5)
    {
        if (Model.ExitDate.HasValue)
        {
            // iş kapanmış: çıkış ile hedefi karşılaştır
            int diff = (Model.ExitDate.Value.Date - Model.TargetDate.Value.Date).Days;

            if (diff <= 0)
            {
                delayText = "Zamanında tamamlandı";
                delayClass = "bg-success";
            }
            else
            {
                delayText = $"{diff} gün geç tamamlandı";
                delayClass = "bg-danger";
            }
        }
        else
        {
            // iş devam ediyor: bugün ile hedefi karşılaştır
            int diff = (DateTime.Now.Date - Model.TargetDate.Value.Date).Days;

            if (diff > 0)
            {
                delayText = $"{diff} gün gecikmede";
                delayClass = "bg-danger";
            }
            else if (diff == 0)
            {
                delayText = "Son gün";
                delayClass = "bg-warning text-dark";
            }
            else
            {
                delayText = $"{-diff} gün kaldı";
                delayClass = "bg-info";
            }
        }
    }
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold mb-1">
            Numune Detayı
        </h2>

        <small class="text-muted">
            @Model.TrackingNo
        </small>

    </div>

    <div>

        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">

            <i class="bi bi-pencil-square"></i>
            Düzenle

        </a>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Listeye Dön

        </a>

    </div>

</div>

<div class="row">

    <div class="col-lg-8">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">

                <h5 class="mb-0">

                    Genel Bilgiler

                </h5>

            </div>

            <div class="card-body">

                <div class="row mb-3">

                    <div class="col-md-4 fw-semibold">
                        Takip No
                    </div>

                    <div class="col-md-8">
                        @Model.TrackingNo
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-md-4 fw-semibold">
                        Teklif No
                    </div>

                    <div class="col-md-8">
                        @Model.OfferNo
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-md-4 fw-semibold">
                        Müşteri
                    </div>

                    <div class="col-md-8">
                        @Model.CustomerName
                    </div>

                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ServicePurchasedFrom))
                {
                    <div class="row mb-3">

                        <div class="col-md-4 fw-semibold">
                            Hizmet Alınan
                        </div>

                        <div class="col-md-8">
                            @Model.ServicePurchasedFrom
                        </div>

                    </div>
                }

                <div class="row mb-3">

                    <div class="col-md-4 fw-semibold">
                        Ürün
                    </div>

                    <div class="col-md-8">
                        @Model.ProductName
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-md-4 fw-semibold">
                        Analiz Bilgisi
                    </div>

                    <div class="col-md-8">
                        @if (!string.IsNullOrWhiteSpace(Model.AnalysisInfo))
                        {
                            foreach (var t in Model.AnalysisInfo.Split('|', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge bg-light text-dark border me-1 mb-1">@t.Trim()</span>
                            }
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-md-4 fw-semibold">
                        Oluşturan
                    </div>

                    <div class="col-md-8">
                        @(Model.CreatedByUser?.FullName ?? "-")
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-md-4 fw-semibold">
                        Son Güncelleyen
                    </div>

                    <div class="col-md-8">
                        @(Model.UpdatedByUser?.FullName ?? "-")
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-md-4 fw-semibold">
                        Güncelleme Tarihi
                    </div>

                    <div class="col-md-8">
                        @(Model.UpdatedDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                    </div>

                </div>

                <div class="row mb-3">

                    <div class="col-md-4 fw-semibold">
                        Kabul Tarihi
                    </div>

                    <div class="col-md-8">
                        @Model.SampleAcceptDate.ToString("dd.MM.yyyy HH:mm")
                    </div>

                </div>

                @if (Model.TargetDate.HasValue)
                {
                    <div class="row mb-3">
                        <div class="col-md-4 fw-semibold">
                            Hedef Tarih
                        </div>
                        <div class="col-md-8">
                            @Model.TargetDate.Value.ToString("dd.MM.yyyy")
                            @if (Model.TargetDays.HasValue)
                            {
                                <span class="text-muted">(@Model.TargetDays iş günü)</span>
                            }
                            @if (delayText != null)
                            {
                                <span class="badge @delayClass ms-2">@delayText</span>
                            }
                        </div>
                    </div>
                }

                @if (Model.ExitDate.HasValue)
                {
                    <div class="row mb-3">

                        <div class="col-md-4 fw-semibold">
                            Çıkış Tarihi
                        </div>

                        <div class="col-md-8">
                            @Model.ExitDate.Value.ToString("dd.MM.yyyy HH:mm")
                        </div>

                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.CargoCompany))
                {
                    <div class="row mb-3">

                        <div class="col-md-4 fw-semibold">
                            Kargo Firması
                        </div>

                        <div class="col-md-8">
                            @Model.CargoCompany
                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

    <div class="col-lg-4">
        @if (Model.StatusId == 4)
        {
            <div class="card shadow-sm border-0 mb-3">

                <div class="card-header bg-white">
                    <h5 class="mb-0">Durum</h5>
                </div>

                <div class="card-body text-center">

                    <span class="badge bg-success fs-6 mb-3 d-block">
                        Rapor Tamamlandı
                    </span>

                    <form asp-action="UpdateStatus" method="post"
                          onsubmit="return confirm('Bu iş Faturalandırıldı olarak işaretlenecek. Emin misiniz?');">

                        <input type="hidden" name="sampleId" value="@Model.Id" />
                        <input type="hidden" name="statusId" value="6" />

                        <button type="submit" class="btn btn-primary w-100">
                            Faturalandırıldı Olarak İşaretle
                        </button>
                    </form>

                </div>

            </div>
        }
        else if (Model.StatusId == 6)
        {
            <div class="card shadow-sm border-0 mb-3">

                <div class="card-header bg-white">
                    <h5 class="mb-0">Durum</h5>
                </div>

                <div class="card-body text-center">

                    <span class="badge bg-dark fs-6">
                        Faturalandırıldı
                    </span>

                    <div class="mt-3 text-muted">
                        Bu iş tamamlanıp faturalandırılmıştır.
                        Durum değiştirilemez.
                    </div>

                </div>

            </div>
        }
        else if (Model.StatusId == 5)
        {
            <div class="card shadow-sm border-0 mb-3">

                <div class="card-header bg-white">
                    <h5 class="mb-0">Durum</h5>
                </div>

                <div class="card-body text-center">

                    <span class="badge bg-danger fs-6">İptal Edildi</span>

                    @if (!string.IsNullOrWhiteSpace(Model.CancelReason))
                    {
                        <div class="mt-3">
                            <strong>İptal Nedeni:</strong><br />
                            @Model.CancelReason
                        </div>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-action="Delete"
                              method="post"
                              class="mt-3"
                              onsubmit="return confirm('Bu kayıt kalıcı olarak silinecek. Emin misiniz?');">

                            <input type="hidden" name="id" value="@Model.Id" />

                            <button type="submit" class="btn btn-danger w-100">
                                Kaydı Kalıcı Olarak Sil
                            </button>
                        </form>
                    }

                </div>

            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 mb-3">

                <div class="card-header bg-white">

                    <h5 class="mb-0">
                        Durum Yönetimi
                    </h5>

                </div>

                <div class="card-body">

                    <form asp-action="UpdateStatus"
                          method="post">

                        <input type="hidden"
                               name="sampleId"
                               value="@Model.Id" />

                        <div class="mb-3">

                            <label class="form-label">
                                Güncel Durum
                            </label>

                            <select name="statusId" class="form-select">

                                @foreach (var status in (List<interTekLabERP.Entities.Status>)ViewBag.Statuses)
                                {
                                    if (status.Id == Model.StatusId)
                                    {
                                        <option value="@status.Id" selected>
                                            @status.StatusName
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="@status.Id">
                                            @status.StatusName
                                        </option>
                                    }
                                }

                            </select>

                            <div id="cargoArea" style="display:none;" class="mt-3">
                                <label class="form-label">
                                    Kargo Firması
                                </label>
                                <input type="text" name="cargoCompany" class="form-control" value="@Model.CargoCompany" />
                            </div>

                            <script>

                                document.addEventListener("DOMContentLoaded", function () {

                                    const statusSelect =
                                        document.querySelector('select[name="statusId"]');

                                    const cargoArea =
                                        document.getElementById("cargoArea");

                                    function checkStatus()
                                    {
                                        const selectedText =
                                            statusSelect.options[
                                                statusSelect.selectedIndex
                                            ].text;

                                        if (selectedText === "Kargoya Verildi")
                                        {
                                            cargoArea.style.display = "block";
                                        }
                                        else
                                        {
                                            cargoArea.style.display = "none";
                                        }
                                    }

                                    statusSelect.addEventListener(
                                        "change",
                                        checkStatus);

                                    checkStatus();
                                });

                            </script>

                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">

                            Durumu Güncelle

                        </button>

                    </form>

                </div>

            </div>

            <div class="card shadow-sm border-0 mb-3">

                <div class="card-header bg-white">
                    <h5 class="mb-0 text-danger">İş İptali</h5>
                </div>

                <div class="card-body">

                    <form asp-action="Cancel"
                          method="post"
                          onsubmit="return confirm('Bu iş iptal edilecek. Emin misiniz?');">

                        <input type="hidden" name="sampleId" value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label">İptal Nedeni</label>
                            <textarea name="reason" class="form-control" rows="2" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-danger w-100">
                            İşi İptal Et
                        </button>

                    </form>

                </div>

            </div>
        }
        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    İşlemler
                </h5>

            </div>

            <div class="card-body text-center">

                <img src="@ViewBag.BarcodeImage"
                     class="img-fluid mb-3" />

                <div class="fw-bold mb-3">
                    @(Model.SampleCode ?? Model.TrackingNo)
                </div>

                <a asp-action="PrintBarcode"
                   asp-route-id="@Model.Id"
                   target="_blank"
                   class="btn btn-success w-100">

                    <i class="bi bi-printer"></i>
                    Barkod Etiketi Oluştur ve Yazdır

                </a>

            </div>

        </div>

    </div>

</div>




<div class="card-body history-container">

    @foreach (var item in (List<SampleHistory>)ViewBag.History)
    {
        <div class="border-start border-4 border-primary ps-3 mb-4">

            <div class="fw-bold">
                @item.ActionType
            </div>

            <div class="text-primary fw-semibold">
                @(item.User?.FullName ?? "-")
            </div>

            <div>
                @item.Description
            </div>

            <small class="text-muted">
                @item.CreatedDate.ToString("dd.MM.yyyy HH:mm")
            </small>

        </div>
    }

</div>

<style>
    .history-container {
        max-height: 500px;
        overflow-y: auto;
        padding-right: 8px;
    }
</style>