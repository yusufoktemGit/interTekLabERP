@model List<interTekLabERP.Entities.SampleRequest>

<div class="d-flex justify-content-between align-items-center mb-3">

    <h3>Numune Kayıtları</h3>

    <div>
        <a asp-action="BulkCreate"
           class="btn btn-primary">
            Toplu Numune Girişi
        </a>

        <a asp-action="Create"
           class="btn btn-success">
            Yeni Numune
        </a>
    </div>

</div>

<div class="card mb-3">
    <div class="card-body">

        <div class="d-flex align-items-center mb-2">
            <i class="bi bi-funnel me-2 text-primary"></i>
            <span class="fw-semibold">Filtrele</span>
            <span class="text-muted ms-2" style="font-size: 0.85rem;">— tüm kayıtlar içinde arar</span>
        </div>

        <form asp-action="Index" method="get" class="row g-2 align-items-end">

            <div class="col-md-3">
                <label class="form-label mb-1">Ara</label>
                <input type="text" name="search" value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Takip no, müşteri, ürün..." />
            </div>

            <div class="col-auto">
                <label class="form-label mb-1">Durum</label>
                <select name="statusId" class="form-select">
                    <option value="">Tümü</option>
                    <option value="1">Beklemede</option>
                    <option value="2">Kargoya Verildi</option>
                    <option value="3">Analiz Devam Ediyor</option>
                    <option value="4">Rapor Tamamlandı</option>
                    <option value="5">İptal Edildi</option>
                    <option value="6">Faturalandırıldı</option>
                </select>
            </div>

            <div class="col-auto">
                <label class="form-label mb-1">Başlangıç</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control" />
            </div>

            <div class="col-auto">
                <label class="form-label mb-1">Bitiş</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control" />
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filtrele
                </button>
            </div>

            <div class="col-auto">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i> Temizle
                </a>
            </div>

        </form>

        <div class="border-top mt-3 pt-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="text-muted" style="font-size: 0.85rem;">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>
                Filtrelenen @Model.Count kaydı dışa aktar
            </span>

            <a asp-action="ExportExcel"
               asp-route-statusId="@(ViewBag.SelectedStatus)"
               asp-route-startDate="@(ViewBag.StartDate)"
               asp-route-endDate="@(ViewBag.EndDate)"
               asp-route-search="@(ViewBag.Search)"
               class="btn btn-success btn-sm">
                <i class="bi bi-download"></i> Excel'e Aktar
            </a>
        </div>

    </div>
</div>

<div class="card">

    <div class="card-body">

        <table id="sampleTable" class="table table-striped table-hover">

            <thead class="table-dark">
                <tr>
                    <th>Takip No</th>
                    <th>Teklif No</th>
                    <th>Müşteri</th>
                    <th>Ürün</th>
                    <th>Hizmet Alan</th>
                    <th>Kabul Tarihi</th>
                    <th>Hedef Tarih</th>
                    <th>Çıkış Tarihi</th>
                    <th>Durum</th>
                    <th width="120">İşlem</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <a asp-action="Detail"
                                   asp-route-id="@item.Id">
                                    @item.TrackingNo
                                </a>
                            </td>

                            <td>@item.OfferNo</td>

                            <td>@item.CustomerName</td>

                            <td>@item.ProductName</td>

                            <td>@item.ServicePurchasedFrom</td>

                            <td>
                                @item.SampleAcceptDate.ToString("dd.MM.yyyy")
                            </td>
                            <td>
                                @if (item.TargetDate.HasValue)
                                {
                                    var gecikti = !item.ExitDate.HasValue
                                    && item.StatusId != 5
                                    && item.TargetDate.Value.Date < DateTime.Now.Date;

                                    <span class="@(gecikti ? "text-danger fw-semibold" : "")">
                                        @item.TargetDate.Value.ToString("dd.MM.yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>
                                @(item.ExitDate.HasValue? item.ExitDate.Value.ToString("dd.MM.yyyy") : "-")
                            </td>
                            <td>
                                @if (item.StatusId == 1)
                                {
                                    <span class="badge bg-secondary">
                                        Beklemede
                                    </span>
                                }
                                else if (item.StatusId == 2)
                                {
                                    <span class="badge bg-primary">
                                        Kargoya Verildi
                                    </span>
                                }
                                else if (item.StatusId == 3)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Analiz Devam Ediyor
                                    </span>
                                }
                                else if (item.StatusId == 4)
                                {
                                    <span class="badge bg-success">
                                        Rapor Tamamlandı
                                    </span>
                                }
                                else if (item.StatusId == 5)
                                {
                                    <span class="badge bg-danger">
                                        İptal Edildi
                                    </span>
                                }
                                else if (item.StatusId == 6)
                                {
                                    <span class="badge bg-dark">
                                        Faturalandırıldı
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="Detail"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-primary">
                                    Detay
                                </a>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">
                            Kayıt bulunamadı.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


@section Scripts
{
    <script>

        $(document).ready(function ()
        {
            $('#sampleTable').DataTable(
            {
                language:
                {
                    url: '//cdn.datatables.net/plug-ins/1.13.8/i18n/tr.json'
                },
                pageLength: 25,
                order: [[0, "desc"]],
                searching: false,
                stateSave: true,
                stateDuration: -1
            });

            // seçili durumu dropdown'da işaretle
            var selectedStatus = '@(ViewBag.SelectedStatus)';
            if (selectedStatus) {
                $('select[name="statusId"]').val(selectedStatus);
            }
        });

    </script>
}
