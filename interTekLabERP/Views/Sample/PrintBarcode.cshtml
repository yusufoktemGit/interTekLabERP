@model interTekLabERP.Entities.SampleRequest

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Barkod Yazdır</title>

    <style>

            body {
                text-align: center;
                font-family: Arial;
                margin-top: 40px;
            }

            img {
                width: 600px;
            }

            .code {
                font-size: 24px;
                font-weight: bold;
                margin-top: 10px;
            }

    </style>

</head>

<body>

    <img src="@ViewBag.BarcodeImage" />

    <div class="code">
        @(Model.SampleCode ?? Model.TrackingNo)
    </div>

    <script>

            window.onload = function ()
            {
                window.print();
            };

    </script>

</body>

</html>