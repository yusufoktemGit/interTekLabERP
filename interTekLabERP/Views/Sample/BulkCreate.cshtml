@model interTekLabERP.ViewModels.BulkSampleViewModel

@{
    ViewData["Title"] = "Toplu Numune Girişi";

    var testCards = (List<interTekLabERP.Entities.TestCard>)ViewBag.TestCards;

    var optionsSb = new System.Text.StringBuilder();
    foreach (var t in testCards)
    {
        optionsSb.Append($"<option value=\"{t.Name}\" data-code=\"{t.Code}\" title=\"{t.Name}\">{t.Name}</option>");
    }
    var optionsHtml = optionsSb.ToString();
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Toplu Numune Girişi</h3>
    <div>
        <a asp-action="Create" class="btn btn-outline-secondary">
            Tekli Giriş
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            Listeye Dön
        </a>
    </div>
</div>

<div class="alert alert-info">
    Aşağıdaki her satır ayrı bir numune olarak kaydedilir ve her birine otomatik takip no verilir.
</div>

<form id="bulkForm" asp-action="BulkCreate" method="post">

    <div class="card mb-3">
        <div class="card-body">
            <div class="text-primary mb-3" style="font-size: 0.85rem;">
                TÜM NUMUNELER İÇİN ORTAK
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Teklif No</label>
                    <input name="OfferNo" value="@Model.OfferNo" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Müşteri Adı</label>
                    <input name="CustomerName" value="@Model.CustomerName" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Numuneler (<span id="rowCount">0</span>)</h5>
        <button type="button" id="addRowBtn" class="btn btn-outline-primary">
            + Satır Ekle
        </button>
    </div>

    <div class="row g-2 px-1 mb-1 text-muted" style="font-size: 0.8rem;">
        <div class="col-3">ÜRÜN ADI</div>
        <div class="col">ANALİZ / TEST</div>
        <div class="col-auto" style="width: 110px;">HEDEF (GÜN)</div>
        <div class="col-2">HİZMET ALINAN</div>
        <div class="col-auto" style="width: 52px;"></div>
    </div>

    <div id="rowsContainer">
        @for (int i = 0; i < Model.Rows.Count; i++)
        {
            <div class="bulk-row row g-2 mb-2 align-items-start">
                <div class="col-3">
                    <input name="Rows[@i].ProductName" value="@Model.Rows[i].ProductName"
                           class="form-control" placeholder="Ürün adı" />
                </div>
                <div class="col">
                    <select name="Rows[@i].AnalysisTests" class="form-select analysis-select" multiple>
                        @foreach (var t in testCards)
                        {
                            if (Model.Rows[i].AnalysisTests != null && Model.Rows[i].AnalysisTests.Contains(t.Name))
                            {
                                <option value="@t.Name" data-code="@t.Code" title="@t.Name" selected>@t.Name</option>

                            }
                            else
                            {
                                <option value="@t.Name" data-code="@t.Code" title="@t.Name">@t.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-auto" style="width: 110px;">
                    <input name="Rows[@i].TargetDays" value="@Model.Rows[i].TargetDays"
                           type="number" min="1" max="99"
                           class="form-control target-days" placeholder="Gün" />
                    <small class="text-muted target-preview" style="font-size: 0.7rem;"></small>
                </div>
                <div class="col-2">
                    <input name="Rows[@i].ServicePurchasedFrom" value="@Model.Rows[i].ServicePurchasedFrom"
                           class="form-control" placeholder="Hizmet alınan" />
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-outline-danger btn-remove">&times;</button>
                </div>
            </div>
        }
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">
            Tümünü Kaydet
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            İptal
        </a>
    </div>

</form>

<template id="rowTemplate">
    <div class="bulk-row row g-2 mb-2 align-items-start">
        <div class="col-3">
            <input name="Rows[__i__].ProductName" class="form-control" placeholder="Ürün adı" />
        </div>
        <div class="col">
            <select name="Rows[__i__].AnalysisTests" class="form-select analysis-select" multiple>
                @Html.Raw(optionsHtml)
            </select>
        </div>
        <div class="col-auto" style="width: 110px;">
            <input name="Rows[__i__].TargetDays" type="number" min="1" max="99"
                   class="form-control target-days" placeholder="Gün" />
            <small class="text-muted target-preview" style="font-size: 0.7rem;"></small>
        </div>
        <div class="col-2">
            <input name="Rows[__i__].ServicePurchasedFrom" class="form-control" placeholder="Hizmet alınan" />
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-outline-danger btn-remove">&times;</button>
        </div>
    </div>
</template>

@section Scripts
{
    <script>
        $(document).ready(function () {

            var $rowsContainer = $('#rowsContainer');
            var tpl = document.getElementById('rowTemplate');
            var counter = $rowsContainer.find('.bulk-row').length;

            function isWorkingDay(d) {
                var g = d.getDay();
                return g !== 0 && g !== 6;
            }

            function calcTarget(days) {
                var now = new Date();
                var current = new Date(now.getFullYear(), now.getMonth(), now.getDate());
                var counted = 0;

                if (now.getHours() < 12 && isWorkingDay(current)) {
                    counted = 1;
                }

                while (counted < days) {
                    current.setDate(current.getDate() + 1);
                    if (isWorkingDay(current)) {
                        counted++;
                    }
                }

                return current;
            }

        function initRow($row) {
                initTestSelect2($row.find('.analysis-select'));
            }

            function updateCount() {
                $('#rowCount').text($rowsContainer.find('.bulk-row').length);
            }

            $rowsContainer.find('.bulk-row').each(function () {
                initRow($(this));
            });

            $('#addRowBtn').on('click', function () {
                var html = tpl.innerHTML.replace(/__i__/g, counter);
                var $row = $(html.trim());
                $rowsContainer.append($row);
                initRow($row);
                counter++;
                updateCount();
            });

            $rowsContainer.on('input', '.target-days', function () {
                if (this.value.length > 2) {
                    this.value = this.value.slice(0, 2);
                }

                var $preview = $(this).closest('.bulk-row').find('.target-preview');
                var days = parseInt(this.value, 10);

                if (!days || days < 1) {
                    $preview.text('');
                    return;
                }

                var d = calcTarget(days);

                $preview.text(d.toLocaleDateString('tr-TR', {
                    day: '2-digit', month: '2-digit', year: 'numeric'
                }));
            });

            $rowsContainer.on('click', '.btn-remove', function () {
                var $row = $(this).closest('.bulk-row');

                if ($rowsContainer.find('.bulk-row').length > 1) {
                    $row.find('.analysis-select').select2('destroy');
                    $row.remove();
                } else {
                    $row.find('input').val('');
                    $row.find('.analysis-select').val(null).trigger('change');
                    $row.find('.target-preview').text('');
                }

                updateCount();
            });

            $('#bulkForm').on('submit', function () {
                $rowsContainer.find('.bulk-row').each(function (idx) {
                    $(this).find('[name]').each(function () {
                        this.name = this.name.replace(/Rows\[\d+\]/, 'Rows[' + idx + ']');
                    });
                });
            });

            updateCount();
        });
    </script>
}
