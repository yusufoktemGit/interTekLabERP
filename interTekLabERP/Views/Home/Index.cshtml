@model interTekLabERP.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <h4>
            Hoşgeldin @User.Identity?.Name 👋
        </h4>

        <p class="text-muted mb-0">
            Yönetim Paneli
        </p>
    </div>
</div>

<div class="row g-3">
    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-3">
            <div class="card text-bg-primary shadow-sm border-0">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6>Toplam Kullanıcı</h6>
                            <h2>@Model.TotalUsers</h2>
                        </div>

                        <i class="bi bi-people fs-1"></i>

                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-bg-success shadow-sm border-0">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6>Aktif Kullanıcı</h6>
                            <h2>@Model.ActiveUsers</h2>
                        </div>

                        <i class="bi bi-person-check fs-1"></i>

                    </div>

                </div>
            </div>
        </div>

    }

    <div class="col-md-3">
        <div class="card text-bg-info shadow-sm border-0">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center">

                    <div>
                        <h6>Toplam Numune</h6>
                        <h2>@Model.TotalSamples</h2>
                    </div>

                    <i class="bi bi-box-seam fs-1"></i>

                </div>

            </div>
        </div>
    </div>

    <div class="col-md-3">
        <a asp-controller="Sample"
           asp-action="Index"
           asp-route-statusId="1"
           class="text-decoration-none">

            <div class="card text-bg-warning shadow-sm">

                <div class="card-body">

                    <h6>Bekleyen Numune</h6>

                    <h2>@Model.PendingSamples</h2>

                </div>

            </div>

        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Sample"
           asp-action="Index"
           asp-route-statusId="2"
           class="text-decoration-none">

            <div class="card text-bg-warning shadow-sm border-0">

                <div class="card-body">

                    <h6>Kargoda</h6>

                    <h2>@Model.ShippedSamples</h2>

                </div>

            </div>

        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Sample"
           asp-action="Index"
           asp-route-statusId="3"
           class="text-decoration-none">

            <div class="card text-bg-info shadow-sm border-0">

                <div class="card-body">

                    <h6>Analizde</h6>

                    <h2>@Model.InAnalysisSamples</h2>

                </div>

            </div>

        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Sample"
           asp-action="Index"
           asp-route-statusId="4"
           class="text-decoration-none">

            <div class="card text-bg-success shadow-sm border-0">

                <div class="card-body">

                    <h6>Tamamlandı</h6>

                    <h2>@Model.CompletedSamples</h2>

                </div>

            </div>

        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Sample"
           asp-action="Index"
           asp-route-statusId="5"
           class="text-decoration-none">

            <div class="card text-bg-danger shadow-sm border-0">

                <div class="card-body">

                    <h6>İptal Edildi</h6>

                    <h2>@Model.CancelledSamples</h2>

                </div>

            </div>

        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Sample"
           asp-action="Index"
           asp-route-statusId="6"
           class="text-decoration-none">

            <div class="card text-bg-dark shadow-sm border-0">

                <div class="card-body">

                    <h6>Faturalandırıldı</h6>

                    <h2>@Model.InvoicedSamples</h2>

                </div>

            </div>

        </a>
    </div>


</div>

<div class="row mt-4">

    <div class="col-lg-8">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">
                <h5 class="mb-0">
                    Son Eklenen Numuneler
                </h5>
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Takip No</th>
                                <th>Müşteri</th>
                                <th>Ürün</th>
                                <th>Durum</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.RecentSamples.Any())
                            {
                                @foreach (var item in Model.RecentSamples)
                                {
                                    <tr>

                                        <td>
                                            @item.TrackingNo
                                        </td>

                                        <td>
                                            @item.CustomerName
                                        </td>

                                        <td>
                                            @item.ProductName
                                        </td>

                                        <td>

                                            @if (item.StatusId == 1)
                                            {
                                                <span class="badge bg-secondary">
                                                    Beklemede
                                                </span>
                                            }
                                            else if (item.StatusId == 2)
                                            {
                                                <span class="badge bg-warning">
                                                    Kargoya Verildi
                                                </span>
                                            }
                                            else if (item.StatusId == 3)
                                            {
                                                <span class="badge bg-info">
                                                    Analiz Devam Ediyor
                                                </span>
                                            }
                                            else if (item.StatusId == 4)
                                            {
                                                <span class="badge bg-success">
                                                    Rapor Tamamlandı
                                                </span>
                                            }
                                            else if (item.StatusId == 5)
                                            {
                                                <span class="badge bg-danger">
                                                    İptal Edildi
                                                </span>
                                            }
                                            else if (item.StatusId == 6)
                                            {
                                                <span class="badge bg-dark">
                                                    Faturalandırıldı
                                                </span>
                                            }

                                        </td>

                                        <td class="text-end">

                                            <a asp-controller="Sample"
                                               asp-action="Detail"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">

                                                Detay

                                            </a>

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">
                                        Henüz kayıt bulunmuyor.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">
                Sistem Özeti
            </div>

            <div class="card-body">
                @if (User.IsInRole("Admin"))
                {
                    <div class="mb-3">
                        <strong>Toplam Kullanıcı:</strong>
                        @Model.TotalUsers
                    </div>

                    <div class="mb-3">
                        <strong>Aktif Kullanıcı:</strong>
                        @Model.ActiveUsers
                    </div>
                }

                <div class="mb-3">
                    <strong>Toplam Numune:</strong>
                    @Model.TotalSamples
                </div>

                <div class="mb-3">
                    <strong>Bekleyen Numune:</strong>
                    @Model.PendingSamples
                </div>

                <div>
                    <strong>Tamamlanan Numune:</strong>
                    @Model.CompletedSamples
                </div>
                <div>
                    <strong>İptal Edilen Numune:</strong>
                    @Model.CancelledSamples
                </div>

            </div>

        </div>

    </div>

</div>